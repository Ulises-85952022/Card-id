-    transform: scale(1.04);
-  }
-  100% {
-    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0), 0 8px 24px rgba(37, 211, 102, 0.4);
-    transform: scale(1);
-  }
+@theme {
+  --color-concreto: #e9ecea;
+  --color-tinta: #172026;
+  --color-acero: #56636d;
+  --color-linea: #d7dcdf;
+  --color-banda: #0d4e8c;
+  --color-banda-oscuro: #0a3d6e;
+  --color-wa: #1a8a4a;
+  --font-sans: "Barlow", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --font-cond: "Barlow Semi Condensed", "Barlow", system-ui, sans-serif;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--color-concreto);
+  color: var(--color-tinta);
+  font-family: var(--font-sans);
+  font-size: 16px;
+  line-height: 1.45;
+  -webkit-font-smoothing: antialiased;
 }
 
-#btn-floating-whatsapp {
-  animation: soft-pulse-wa 3s ease-in-out infinite;
-  transform-origin: center center;
+:focus-visible {
+  outline: 3px solid var(--color-banda);
+  outline-offset: 2px;
+  border-radius: 6px;
 }
 
-#btn-floating-whatsapp:hover {
-  animation: none;
-  transform: scale(1.08);
+/* La franja de banda modular: el único elemento con personalidad.
+   Eslabones desfasados medio paso, como una banda uni-chain. */
+.banda-modular {
+  background-color: var(--color-tinta);
+  background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='28' height='36'><g fill='%23ffffff' fill-opacity='0.09'><rect x='2' y='2' width='24' height='14' rx='3'/><rect x='-12' y='20' width='24' height='14' rx='3'/><rect x='16' y='20' width='24' height='14' rx='3'/></g><g fill='%23ffffff' fill-opacity='0.16'><circle cx='14' cy='9' r='1.4'/><circle cx='0' cy='27' r='1.4'/><circle cx='28' cy='27' r='1.4'/></g></svg>");
+  background-size: 28px 36px;
+  background-repeat: repeat;
+  animation: banda-arranca 1.8s cubic-bezier(0.25, 0.7, 0.2, 1) 0.1s both;
+}
+
+/* Arranca una sola vez, como un transportador al encender, y se detiene */
+@keyframes banda-arranca {
+  from {
+    background-position: -224px 0;
+  }
+  to {
+    background-position: 0 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+  }
 }
-- 
